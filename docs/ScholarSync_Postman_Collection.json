{
  "info": {
    "_postman_id": "scholarsync-backend-api-v1",
    "name": "ScholarSync REST API",
    "description": "Complete Postman collection for testing the ScholarSync Express Backend REST API running on localhost:5000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "sampleUserId",
      "value": "user_demo_scholar_123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies that the Express REST backend is running properly on port 5000."
          }
        }
      ]
    },
    {
      "name": "Books Management",
      "item": [
        {
          "name": "Get All Books (by User ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?userId={{sampleUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{sampleUserId}}",
                  "description": "Clerk ID or MongoDB user ID"
                },
                {
                  "key": "search",
                  "value": "Calculus",
                  "disabled": true,
                  "description": "Optional search keyword"
                }
              ]
            },
            "description": "Retrieves all indexed books belonging to the specified user."
          }
        },
        {
          "name": "Check Book Exists (by Title)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/check/Computer%20Science%20101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "check", "Computer%20Science%20101"]
            },
            "description": "Checks if a book with the given title slug already exists in MongoDB."
          }
        },
        {
          "name": "Get Book by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/slug/computer-science-101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "slug", "computer-science-101"]
            },
            "description": "Fetches complete book document details by its URL slug."
          }
        },
        {
          "name": "Create New Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{sampleUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Operating Systems\",\n  \"author\": \"Andrew S. Tanenbaum\",\n  \"coverURL\": \"https://images.unsplash.com/photo-1532012164546-f432f2e3777a?auto=format&fit=crop&q=80&w=600\",\n  \"pdfURL\": \"https://example.com/sample-os.pdf\",\n  \"fileSize\": 15420000,\n  \"summary\": \"Comprehensive guide on OS processes, scheduling, virtualization, and memory management.\",\n  \"userId\": \"{{sampleUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            },
            "description": "Registers a new academic textbook or study paper in MongoDB."
          }
        },
        {
          "name": "Save Book Segments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"segments\": [\n    {\n      \"content\": \"Operating systems provide an abstraction layer between hardware and user applications. The core component is the kernel.\",\n      \"pageNumber\": 1,\n      \"wordCount\": 20\n    },\n    {\n      \"content\": \"Process scheduling algorithms include First-Come First-Served (FCFS), Shortest Job Next (SJN), and Round Robin (RR).\",\n      \"pageNumber\": 2,\n      \"wordCount\": 18\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/REPLACE_WITH_BOOK_ID/segments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "REPLACE_WITH_BOOK_ID", "segments"]
            },
            "description": "Saves parsed text chunks and page numbers into the BookSegment collection."
          }
        }
      ]
    },
    {
      "name": "AI Study Companion (Groq LLM)",
      "item": [
        {
          "name": "Chat with Book (Contextual RAG Q&A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"671500000000000000000001\",\n  \"bookTitle\": \"Introduction to Operating Systems\",\n  \"userMessage\": \"Explain how Round Robin scheduling works and what its trade-offs are.\",\n  \"history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello, can you help me study this book?\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Hello! I am your AI study companion for Introduction to Operating Systems. Ask me any question about the concepts or chapters.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Queries the Groq LLaMA model with textbook segment context and chat history to provide academic explanations."
          }
        }
      ]
    },
    {
      "name": "User & Admin Management",
      "item": [
        {
          "name": "Sync User (Clerk to MongoDB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clerkId\": \"user_demo_scholar_123\",\n  \"email\": \"student.scholar@university.edu\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Rivera\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/sync-user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "sync-user"]
            },
            "description": "Synchronizes authenticated Clerk user records into the local MongoDB User collection."
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "Fetches all registered users along with their total indexed book count."
          }
        }
      ]
    },
    {
      "name": "Study Sessions",
      "item": [
        {
          "name": "Start Voice/Study Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{sampleUserId}}\",\n  \"bookId\": \"671500000000000000000001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/session/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session", "start"]
            },
            "description": "Initiates a telemetry tracking session for voice tutoring or active reading."
          }
        }
      ]
    }
  ]
}
